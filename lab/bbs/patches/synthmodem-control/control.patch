     } else {
         process_command_mode_bytes(buf, (size_t)n);
+    }
+    if (was_data_mode && !S.data_mode && pty_busy()) {
+        LOGI("Discarding queued session data after carrier loss");
+        S.pty_tx_at = S.pty_tx_len = 0;
+    }
+    return 0;
+}
+
+static int dispatch_host_frames(void) {
+    while (!pty_busy() && !S.hangup_phase) {
+        uint8_t type = 0, *payload = NULL;
+        size_t plen = 0;
+        int r = wire_try_parse(S.ctrl_rx_buf, &S.ctrl_rx_len, &type, &payload, &plen);
+        if (r <= 0) return r;
+        switch (type) {
+        case WIRE_TYPE_AT:
+            if (queue_pty(payload, plen, true) < 0) return -1;
+            break;
+        case WIRE_TYPE_DATA_TX:
+            if (S.data_mode && queue_pty(payload, plen, false) < 0) return -1;
+            break;
+        case WIRE_TYPE_HANGUP:
+            S.hangup_phase = 1;
+            S.hangup_deadline = monotonic_ms() + 1100;
+            break;
+        default: break;
+        }
     }
     return 0;
 }
