  * Poll loop handlers
  * ────────────────────────────────────────────────────────────────── */
 
+static int pty_busy(void) { return S.pty_tx_at < S.pty_tx_len; }
+
+static int queue_pty(const void *data, size_t len, bool cr) {
+    if (S.pty_fd < 0 || pty_busy() || len + (cr ? 1u : 0u) > sizeof(S.pty_tx)) {
+        LOGE("PTY unavailable or queue admission failed");
+        return -1;
+    }
+    memcpy(S.pty_tx, data, len);
+    if (cr) S.pty_tx[len++] = '\r';
+    S.pty_tx_at = 0;
+    S.pty_tx_len = len;
+    return 0;
+}
+
+static int flush_pty(void) {
+    if (!pty_busy()) return 0;
+    ssize_t n = write(S.pty_fd, S.pty_tx + S.pty_tx_at, S.pty_tx_len - S.pty_tx_at);
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) return 0;
+    if (n <= 0) { LOGE("PTY write failed: %s", n ? strerror(errno) : "zero write"); return -1; }
+    S.pty_tx_at += (size_t)n;
+    return 0;
+}
+
+static long long monotonic_ms(void) {
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (long long)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+static int progress_hangup(void) {
+    switch (S.hangup_phase) {
+    case 1:
+        if (monotonic_ms() >= S.hangup_deadline) {
+            if (queue_pty("+++", 3, false) < 0) return -1;
+            S.hangup_phase = 2;
+        }
+        break;
+    case 2:
+        if (!pty_busy()) { S.hangup_deadline = monotonic_ms() + 1100; S.hangup_phase = 3; }
+        break;
+    case 3:
+        if (monotonic_ms() >= S.hangup_deadline) {
+            if (queue_pty("ATH", 3, true) < 0) return -1;
+            S.hangup_phase = 4;
+        }
+        break;
+    case 4: if (!pty_busy()) S.hangup_phase = 0; break;
+    }
+    return 0;
+}
+
