#!/bin/sh
set -eu
pcplus_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$pcplus_root"
# Impurity resolves this checkout; Nixpkgs and the upstream source stay pinned.
exec nix --extra-experimental-features 'nix-command flakes' build --impure --expr \
  'let flake = builtins.getFlake (toString ./nix); pkgs = import flake.inputs.nixpkgs { system = builtins.currentSystem; }; in import ./nix/sexyz-send-credit-eof.nix { inherit pkgs; }' "$@"
